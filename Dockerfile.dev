# Dev-only image shared by the backend and frontend services in
# docker-compose.yml (they just override `command`). Not used for
# production — see PHASES.md's deployment phase for that.
#
# Source is bind-mounted over this at runtime for hot reload; node_modules
# is deliberately NOT bind-mounted (see the anonymous volumes in
# docker-compose.yml) so each package keeps the Linux-native binaries
# (Prisma's engine, esbuild, etc.) installed here rather than whatever the
# host machine's OS/arch produced.
FROM node:22-alpine
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@11.10.0 --activate

COPY . .
RUN pnpm install
