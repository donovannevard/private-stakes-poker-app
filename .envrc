# Fixed local dev ports so this repo never collides with other local
# projects running at the same time. Names match the vars docker-compose.yml
# and the app code already read (BACKEND_PORT/FRONTEND_PORT/POSTGRES_PORT,
# PORT, VITE_BACKEND_PORT) — see docker-compose.yml and .env.example.
#
# `dotenv .env` pulls in POSTGRES_USER/PASSWORD/DB (and anything else in
# .env) first, so the exports below can override its PORT/POSTGRES_PORT and
# rebuild DATABASE_URL from the port actually assigned here — instead of
# duplicating a literal connection string in .env that silently drifts out
# of sync whenever a port changes.
dotenv .env

export BACKEND_PORT=3031
export FRONTEND_PORT=3032
export POSTGRES_PORT=5443

# Used directly by backend/src/server.ts and frontend/src/lib/api.ts +
# socket.ts when running outside Docker (`pnpm dev` at the repo root).
export PORT=$BACKEND_PORT
export VITE_BACKEND_PORT=$BACKEND_PORT

# Rebuilt here instead of duplicated in .env, so it always matches
# POSTGRES_PORT above. Native, non-Docker persistence silently no-ops
# without direnv active, same as it already no-ops when DATABASE_URL is
# unset — see database/src/client.ts.
export DATABASE_URL="postgresql://${POSTGRES_USER:-lightning_poker}:${POSTGRES_PASSWORD:-lightning_poker}@localhost:${POSTGRES_PORT}/${POSTGRES_DB:-lightning_poker}"
