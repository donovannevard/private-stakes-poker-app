POSTGRES_USER=lightning_poker
POSTGRES_PASSWORD=lightning_poker
POSTGRES_DB=lightning_poker
POSTGRES_PORT=5432
DATABASE_URL=postgresql://lightning_poker:lightning_poker@localhost:5432/lightning_poker
PORT=3000
# Signs the session cookie — set a real random value for any real deployment.
COOKIE_SECRET=dev-only-insecure-secret-change-me
# A 6-digit code friends must enter once per browser before they can reach
# anything else — required for any deployment reachable outside your LAN.
# Leave unset for local/LAN dev: the gate is a no-op without it.
ACCESS_CODE=
